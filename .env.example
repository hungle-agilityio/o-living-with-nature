# Environment of the Django app. Copy to .env and fill in; the real .env is never committed.
# On Render these are set in render.yaml or in the dashboard (secrets: "sync: false").

# 1 in development, 0 in production.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0; Render generates it.
DJANGO_SECRET_KEY=
# Comma-separated host names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public base URL of the site, used for canonical links (one place only).
SITE_BASE_URL=http://localhost:8000
# Optional: another SQLite file (the browser check uses a throw-away one).
DJANGO_DB_NAME=
