# Copy to .flow/loop/agent.env (git-ignored, never committed) and edit. If .flow/loop/agent.env is missing, the
# loop reads agent.env in the state folder from .flow/flow.toml (~/.o-living for Ở — Living with Nature).

# Builds at once, a whole number from 1 to 3. Missing: 1. The Mac mini uses 2.
AGENT_CONCURRENCY=2

# Optional ntfy.sh topic for every loop message (see .flow/loop/README.md, "Phone messages").
# Empty or missing: no notifications. Pick a long random name; anyone who knows it can read it.
NTFY_TOPIC=

# Optional Slack Incoming Webhook URL; every message also goes there. It is a secret:
# keep it only in agent.env in the state folder, never in the repository or a log.
SLACK_WEBHOOK_URL=
